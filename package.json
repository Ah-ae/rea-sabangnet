{
  "name": "triggerfish",
  "version": "0.1.0",
  "description": "스마트스토어 매출 정산 엔진 — 사방넷 정산관리 핵심 기능을 참고해 구현한 멀티채널 정산/대사 코어",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "triggerfish": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^20.17.9"
  }
}
